{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "files": {
    // VENDORED UPSTREAM SOURCE — formatted by the repo it came from, not by
    // this one. `src/chart/report/__fixtures__/vendor/` holds fabrika's own
    // lane compiler and the two committed `workflow.json` templates, copied at
    // a recorded commit and used as the golden oracle the importer is asserted
    // against. Reformatting them would make every re-vendor a whole-file diff
    // and hide the change that actually matters, so biome leaves them alone.
    // tsc does NOT: they are inside `src` and must still compile.
    "includes": ["**", "!src/chart/report/__fixtures__/vendor/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
