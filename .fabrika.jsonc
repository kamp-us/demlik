{
	// The CI gate whose jobs supersede `fabrika build check`'s in-tree verdict. fabrika's shipped
	// default names phoenix's `ci.yml`; this repo's gate is `build.yaml` (#54). `ci.noProducer` is
	// deliberately not set — it only applies to a repo with zero workflows, so here it would be inert.
	"ci": { "gateWorkflow": "build.yaml" },

	// Who may declare a campaign or flip its state in ROADMAP.md. The same team that owns every
	// governed path in CODEOWNERS; each author must still hold `write` on the repo at the moment.
	"campaignAuthors": ["@kamp-us/control-plane"],

	// The commands `fabrika build check --surface code` spawns in-tree; with none declared the verb
	// refuses UNKNOWN (#63, #70). All three are `package.json` scripts CI runs first: `typecheck` is
	// `tsc --noEmit`, `typecheck:test` covers the test tsconfig, `lint:worktree` is the alias of
	// `lint` kept for this verb by name (CLAUDE.md). No `--force` on any — that is turbo's flag and
	// `tsc` rejects it (TS5093). The tests stay CI's.
	"codeValidators": [
		{ "command": ["pnpm", "typecheck"] },
		{ "command": ["pnpm", "typecheck:test"] },
		{ "command": ["pnpm", "lint:worktree"] }
	],

	// The install `lane integrate` runs in an epic's assembly worktree after each child merge and
	// before the validators, so a child that moves the lockfile is checked against what it pins
	// (#292). `--frozen-lockfile` refuses a lockfile the merge left out of step with package.json.
	"dependencyReconciler": { "command": ["pnpm", "install", "--frozen-lockfile"] },

	// The paths whose diffs make the governance gate `required`. This list replaces fabrika's shipped
	// default wholesale, so it restates the roots that still apply here (`claude-plugins/` does not
	// exist in this repo) and adds the surfaces this repo's ADRs govern: each published package's
	// `package.json` (the export map, ADR 0010), tea's `MAINTAINING.md` (the tier stamps and removal
	// ritual, ADR 0016), the root `package.json` + `pnpm-workspace.yaml` that shape the workspace, and
	// every `biome.jsonc` — lint config is a gate, and a nested one can relax it for one package. `.patterns/`
	// is here because CLAUDE.md names it beside `.decisions/` as a surface fabrika writes through.
	// `.fabrika.jsonc` must stay listed or the config refuses to load. `ROADMAP.md` is board config,
	// not decision corpus, and is deliberately absent.
	"governedRoots": [
		".decisions/",
		".patterns/",
		".claude/",
		".github/",
		".fabrika.jsonc",
		"package.json",
		"pnpm-workspace.yaml",
		"packages/tea/package.json",
		"packages/tea/MAINTAINING.md",
		"packages/code-graph/package.json",
		"packages/structure-sweep/package.json",
		"packages/backlog-sweep/package.json",
		"biome.jsonc",
		"packages/code-graph/biome.jsonc"
	],

	// No standing lanes: every issue homes on a milestone. Left out, this key falls back to the
	// shipped pair (`wayfinder:backlog`, `axis:pipeline-hardening`), which are phoenix's lanes and
	// have no label here.
	"boardVocabulary": { "standingLanes": [] },

	// ADR 0013 does not adopt the rendered-visual lane, so a missing design manifest is expected
	// here, not a gap to fail on.
	"surfaceDispositions": { "design-manifest": "degrade" }
}
