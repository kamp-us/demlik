{
  "name": "demlik",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/demlik.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:test": "pnpm -r --if-present typecheck:test",
    "lint": "pnpm -r lint",
    "lint:worktree": "pnpm -r lint:worktree",
    "test": "vitest run",
    "parity": "pnpm --filter @demlik/parity verify",
    "parity:complete": "pnpm --filter @demlik/parity verify:complete",
    "parity:mutations": "pnpm --filter @demlik/parity verify:mutations",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace && cargo test --workspace --all-features",
    "check:merge-markers": "node scripts/check-merge-markers.mjs",
    "check:codeowners": "node scripts/check-codeowners.mjs",
    "check:catalog": "fabrika guard catalog-guard check",
    "release": "changeset",
    "release:version": "node scripts/release-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@kampus/fabrika-cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.2.1",
  "volta": {
    "node": "23.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
