{
  "name": "demlik",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/demlik.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:test": "pnpm -r --if-present typecheck:test",
    "lint": "pnpm -r lint",
    "lint:worktree": "pnpm -r lint:worktree",
    "test": "vitest run",
    "check:merge-markers": "node scripts/check-merge-markers.mjs",
    "release": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@changesets/cli": "^2.27.11",
    "@kampus/fabrika-cli": "0.7.1",
    "vitest": "~5.0.1"
  },
  "packageManager": "pnpm@10.2.1",
  "volta": {
    "node": "23.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
