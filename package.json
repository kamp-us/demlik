{
  "name": "@demlik/tea",
  "version": "0.12.0",
  "description": "TEA-faithful state machine substrate — one package, every host adapter. Core + subs + testing, plus React, Durable Object, Chrome extension, Node, in-memory, devtools, and property-testing modules as subpaths.",
  "keywords": [
    "tea",
    "elm-architecture",
    "state-machine",
    "reducer",
    "cloudflare",
    "durable-objects",
    "react",
    "effects-as-data"
  ],
  "homepage": "https://demlik.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/demlik.git"
  },
  "license": "MIT",
  "author": "Can Sirin",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./subs": {
      "types": "./dist/subs/index.d.ts",
      "import": "./dist/subs/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./do": {
      "types": "./dist/do/index.d.ts",
      "import": "./dist/do/index.js"
    },
    "./mem": {
      "types": "./dist/mem/index.d.ts",
      "import": "./dist/mem/index.js"
    },
    "./journal": {
      "types": "./dist/journal/index.d.ts",
      "import": "./dist/journal/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./devtools/styles.css": "./dist/devtools/styles.css",
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    },
    "./extension/react": {
      "types": "./dist/extension/react.d.ts",
      "import": "./dist/extension/react.js"
    },
    "./extension/subs": {
      "types": "./dist/extension/subs/index.d.ts",
      "import": "./dist/extension/subs/index.js"
    },
    "./extension/test-utils": {
      "types": "./dist/extension/test-utils.d.ts",
      "import": "./dist/extension/test-utils.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./pbt": {
      "types": "./dist/pbt/index.d.ts",
      "import": "./dist/pbt/index.js"
    },
    "./pbt/arbitraries": {
      "types": "./dist/pbt/arbitraries/index.d.ts",
      "import": "./dist/pbt/arbitraries/index.js"
    },
    "./pbt/runners": {
      "types": "./dist/pbt/runners/index.d.ts",
      "import": "./dist/pbt/runners/index.js"
    },
    "./retry-backoff": {
      "types": "./dist/retry-backoff/index.d.ts",
      "import": "./dist/retry-backoff/index.js"
    },
    "./machine-viz": {
      "types": "./dist/machine-viz/index.d.ts",
      "import": "./dist/machine-viz/index.js"
    },
    "./recorder": {
      "types": "./dist/recorder/index.d.ts",
      "import": "./dist/recorder/index.js"
    },
    "./trace-replay": {
      "types": "./dist/trace-replay/index.d.ts",
      "import": "./dist/trace-replay/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "import": "./dist/snapshot/index.js"
    },
    "./llm-call": {
      "types": "./dist/llm-call/index.d.ts",
      "import": "./dist/llm-call/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./prediction": {
      "types": "./dist/prediction/index.d.ts",
