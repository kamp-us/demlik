    },
    "./pure": {
      "types": "./dist/pure/index.d.ts",
      "import": "./dist/pure/index.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "import": "./dist/parity/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./chart/inspect": {
      "types": "./dist/chart/inspect/index.d.ts",
      "import": "./dist/chart/inspect/index.js"
    },
    "./chart/inspect/react": {
      "types": "./dist/chart/inspect/react.d.ts",
      "import": "./dist/chart/inspect/react.js"
    },
    "./chart/inspect/styles.css": "./dist/chart/inspect/styles.css",
    "./chart/report": {
      "types": "./dist/chart/report/index.d.ts",
      "import": "./dist/chart/report/index.js"
    },
    "./chart/lane": {
      "types": "./dist/chart/lane/index.d.ts",
      "import": "./dist/chart/lane/index.js"
    },
    "./chart/lane/react": {
      "types": "./dist/chart/lane/react.d.ts",
      "import": "./dist/chart/lane/react.js"
    },
    "./chart/lane/server": {
      "types": "./dist/chart/lane/server.d.ts",
      "import": "./dist/chart/lane/server.js"
    },
    "./chart/lane/styles.css": "./dist/chart/lane/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup && node build-viewer.mjs",
    "lint": "biome check src package.json",
    "lint:worktree": "biome check src package.json",
    "test": "vitest run",
    "demo:saga": "vitest run src/internal/flow/workflow/demo.test.ts",
    "lane:view": "vite --config demo/lane-view/vite.config.ts",
    "lane:watch": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lane-watch.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:consumers": "tsc -p tsconfig.consumers.json",
    "docs:reference": "TEA_DOCS_WRITE=1 vitest run src/docs/reference/generate-reference.test.ts",
    "docs:reference:check": "pnpm run docs:reference && git diff --exit-code -- docs/reference",
    "prepublishOnly": "NODE_OPTIONS=--max-old-space-size=8192 tsup && node scripts/verify-exports.mjs",
    "verify-exports": "node scripts/verify-exports.mjs",
    "check:chart-probes": "node scripts/check-chart-probes.mjs",
    "check:merge-markers": "node scripts/check-merge-markers.mjs",
    "release": "changeset",
    "build:viewer": "node build-viewer.mjs"
  },
  "dependencies": {
    "better-result": "^2.5.2",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "fast-check": "^3 || ^4",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vitest": "^2 || ^3",
    "ws": "^8"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@biomejs/biome": "2.3.14",
    "@changesets/cli": "^2.27.11",
    "@cloudflare/workers-types": "4.20260312.1",
    "@kampus/fabrika-cli": "0.5.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^22",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/ws": "8.5.14",
    "@vitejs/plugin-react": "^6.0.5",
    "fast-check": "^3.23.0",
    "happy-dom": "^20.9.0",
    "mermaid": "^11.16.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsup": "^8.3.5",
    "typedoc": "0.28.20",
    "typescript": "5.7.3",
    "vite": "^8.2.1",
    "vitest": "~3.0.7",
    "ws": "8.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/kamp-us/demlik/issues"
  },
  "packageManager": "pnpm@10.2.1",
  "volta": {
    "node": "23.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
