[14.655, "o", "\r\n"]
[15.155, "o", "  \u001b[38;5;213m\u001b[1m1.\u001b[0m \u001b[38;5;44m\u001b[1mElect a leader\u001b[0m\r\n"]
[15.655, "o", "\u001b[38;5;245m  n0 times out, runs an election, and wins a majority (term 1).\u001b[0m\r\n"]
[18.364, "o", "  \u001b[38;5;245mleader: \u001b[0m\u001b[38;5;36m\u001b[1mn0\u001b[0m\r\n"]
[18.764, "o", "    \u001b[38;5;36m▸\u001b[0m \u001b[38;5;252m\u001b[1mn0\u001b[0m  \u001b[38;5;36mleader    \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m0\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;245m[]\u001b[0m\r\n"]
[19.084, "o", "      \u001b[38;5;252m\u001b[1mn1\u001b[0m  \u001b[38;5;252mfollower  \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m0\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;245m[]\u001b[0m\r\n"]
[19.404, "o", "      \u001b[38;5;252m\u001b[1mn2\u001b[0m  \u001b[38;5;252mfollower  \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m0\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;245m[]\u001b[0m\r\n"]
[19.724, "o", "\r\n"]
[19.974, "o", "\r\n"]
[20.474, "o", "  \u001b[38;5;213m\u001b[1m2.\u001b[0m \u001b[38;5;44m\u001b[1mReplicate + commit a command\u001b[0m\r\n"]
[20.974, "o", "\u001b[38;5;245m  client sends 42 to the leader; it replicates to a majority, commits, and the next heartbeat carries the commit to the followers.\u001b[0m\r\n"]
[26.564, "o", "  \u001b[38;5;245mleader: \u001b[0m\u001b[38;5;36m\u001b[1mn0\u001b[0m\r\n"]
[26.964, "o", "    \u001b[38;5;36m▸\u001b[0m \u001b[38;5;252m\u001b[1mn0\u001b[0m  \u001b[38;5;36mleader    \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;221m\u001b[1m[42]\u001b[0m\r\n"]
