[34.261, "o", "      \u001b[38;5;252m\u001b[1mn1\u001b[0m  \u001b[38;5;252mfollower  \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;221m\u001b[1m[42]\u001b[0m\r\n"]
[34.581, "o", "      \u001b[38;5;252m\u001b[1mn2\u001b[0m  \u001b[38;5;252mfollower  \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;221m\u001b[1m[42]\u001b[0m\r\n"]
[34.901, "o", "\r\n"]
[35.151, "o", "\r\n"]
[35.651, "o", "  \u001b[38;5;213m\u001b[1m4.\u001b[0m \u001b[38;5;44m\u001b[1mA new leader is elected\u001b[0m\r\n"]
[36.151, "o", "\u001b[38;5;44m  ↑ a survivor times out and wins a HIGHER term — that's the safety rule.\u001b[0m\r\n"]
[37.551, "o", "\u001b[38;5;245m  a surviving follower (n1) times out and wins the surviving majority {n1,n2} in a higher term.\u001b[0m\r\n"]
[41.636, "o", "  \u001b[38;5;245mleader: \u001b[0m\u001b[38;5;36m\u001b[1mn1\u001b[0m\r\n"]
[42.036, "o", "    \u001b[38;5;36m▸\u001b[0m \u001b[38;5;252m\u001b[1mn0\u001b[0m  \u001b[38;5;36mleader    \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;221m\u001b[1m[42]\u001b[0m\r\n"]
