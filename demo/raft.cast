[0.0, "o", "\u001b[2J\u001b[H"]
[0.3, "o", "\r\n"]
[0.3, "o", "  \u001b[38;5;176m\u001b[1m@demlik/tea/raft\u001b[0m\u001b[38;5;252m  —  consensus you can replay\u001b[0m\r\n"]
[0.3, "o", "  \u001b[38;5;245m────────────────────────────────────────────\u001b[0m\r\n"]
[1.0, "o", "\u001b[38;5;245m  Raft keeps a cluster agreeing on one log, even when a node dies.\u001b[0m\r\n"]
[3.838, "o", "\u001b[38;5;245m  This whole run is a deterministic replay — same trace, same bytes, every time.\u001b[0m\r\n"]
[7.878, "o", "\u001b[38;5;245m  Watch five moves: elect · commit · kill the leader · re-elect · converge.\u001b[0m\r\n"]
[12.903, "o", "\u001b[38;5;36m❯ \u001b[0m"]
