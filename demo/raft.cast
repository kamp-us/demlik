[27.604, "o", "      \u001b[38;5;252m\u001b[1mn2\u001b[0m  \u001b[38;5;252mfollower  \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;221m\u001b[1m[42]\u001b[0m\r\n"]
[27.924, "o", "\r\n"]
[28.174, "o", "\r\n"]
[28.674, "o", "  \u001b[38;5;213m\u001b[1m3.\u001b[0m \u001b[38;5;44m\u001b[1mKill the leader\u001b[0m\r\n"]
[29.174, "o", "\u001b[38;5;203m  ✗ the leader goes dark — every message to and from it is dropped.\u001b[0m\r\n"]
[30.574, "o", "\u001b[38;5;245m  partition isolates n0 — the transport drops all traffic to/from it.\u001b[0m\r\n"]
[33.541, "o", "  \u001b[38;5;245mleader: \u001b[0m\u001b[38;5;36m\u001b[1mn0\u001b[0m\r\n"]
