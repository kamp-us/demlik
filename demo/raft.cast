[42.676, "o", "      \u001b[38;5;252m\u001b[1mn2\u001b[0m  \u001b[38;5;252mfollower  \u001b[0m\u001b[38;5;245mterm=\u001b[0m\u001b[38;5;213m2\u001b[0m \u001b[38;5;245mcommit=\u001b[0m\u001b[38;5;213m1\u001b[0m \u001b[38;5;245mcommitted=\u001b[0m\u001b[38;5;221m\u001b[1m[42]\u001b[0m\r\n"]
[42.996, "o", "\r\n"]
[43.246, "o", "\r\n"]
[43.746, "o", "  \u001b[38;5;213m\u001b[1m5.\u001b[0m \u001b[38;5;44m\u001b[1mReplicate on the new leader → logs converged\u001b[0m\r\n"]
[44.246, "o", "\u001b[38;5;36m  ✓ the new leader commits on the surviving majority; the logs converge.\u001b[0m\r\n"]
[45.646, "o", "\u001b[38;5;245m  client sends 77 to the new leader; it commits on the surviving majority, and a heartbeat converges the survivors' committed logs.\u001b[0m\r\n"]
