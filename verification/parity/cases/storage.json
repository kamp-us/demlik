{
  "version": 1,
  "cases": [
    {
      "id": "storage.memory-alias-live-and-snapshot",
      "operation": "tea.storage.memory",
      "input": {
        "objects": {
          "seed": {
            "count": 1,
            "items": []
          }
        },
        "initial": "seed",
        "actions": [
          {
            "op": "load",
            "as": "loaded"
          },
          {
            "op": "snapshot",
            "reference": "seed"
          },
          {
            "op": "same",
            "left": "seed",
            "right": "loaded"
          },
          {
            "op": "mutate",
            "reference": "seed",
            "path": ["count"],
            "value": 2
          },
          {
            "op": "mutate",
            "reference": "seed",
            "path": ["items"],
            "push": true,
            "value": "x"
          },
          {
            "op": "load"
          },
          {
            "op": "migrate",
            "reference": "loaded",
            "as": "migrated"
          },
          {
            "op": "same",
            "left": "loaded",
            "right": "migrated"
          }
        ]
      },
      "expected": {
        "fenced": false,
        "observations": [
          {
            "op": "load",
            "raw": {
              "count": 2,
              "items": ["x"]
            }
          },
          {
            "op": "snapshot",
            "raw": {
              "count": 1,
              "items": []
            }
          },
          {
            "op": "same",
            "same": true
          },
          {
            "op": "mutate"
          },
          {
            "op": "mutate"
          },
          {
            "op": "load",
            "raw": {
              "count": 2,
              "items": ["x"]
            }
          },
          {
            "op": "migrate",
            "raw": {
              "count": 2,
              "items": ["x"]
            }
          },
          {
            "op": "same",
            "same": true
          }
        ]
      }
    },
