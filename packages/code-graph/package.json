{
  "name": "@demlik/code-graph",
  "version": "0.0.3",
  "description": "Agent-native TypeScript code-graph + smell CLI: parse a folder with oxc, resolve it with tsgo, measure every function, flag smells, and rank refactor targets as deterministic JSON.",
  "homepage": "https://github.com/kamp-us/demlik/tree/main/packages/code-graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/demlik.git",
    "directory": "packages/code-graph"
  },
  "bugs": {
    "url": "https://github.com/kamp-us/demlik/issues"
  },
  "license": "Apache-2.0",
  "author": "Can Sirin",
  "type": "module",
  "bin": {
    "code-graph": "./dist/index.js"
  },
  "exports": {
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js"
    },
    "./scc": {
      "types": "./dist/scc.d.ts",
      "import": "./dist/scc.js"
    },
    "./boundaries": {
      "types": "./dist/boundaries.d.ts",
      "import": "./dist/boundaries.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src package.json biome.jsonc",
    "lint:worktree": "biome check src package.json biome.jsonc",
    "test": "vitest run",
    "verify:exports": "node scripts/verify-exports.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript/native-preview": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "jsonc-parser": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:",
    "smol-toml": "catalog:",
    "zod": "catalog:code-graph"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:code-graph",
    "tsup": "catalog:code-graph",
    "tsx": "catalog:",
    "typescript": "catalog:code-graph",
    "vitest": "catalog:"
  }
}
