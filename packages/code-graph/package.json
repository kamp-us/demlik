{
  "name": "@demlik/code-graph",
  "version": "0.0.2",
  "private": true,
  "description": "Agent-native TypeScript code-graph + smell CLI: parse a folder with ts-morph, measure every function, flag smells, and rank refactor targets as deterministic JSON.",
  "homepage": "https://github.com/kamp-us/demlik/tree/main/packages/code-graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/demlik.git",
    "directory": "packages/code-graph"
  },
  "bugs": {
    "url": "https://github.com/kamp-us/demlik/issues"
  },
  "license": "Apache-2.0",
  "author": "Can Sirin",
  "type": "module",
  "bin": {
    "code-graph": "./dist/index.js"
  },
  "exports": {
    "./resolve": "./src/resolve.ts",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./resolve": {
        "types": "./dist/resolve.d.ts",
        "import": "./dist/resolve.js"
      },
      "./dist/*": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src package.json biome.jsonc",
    "lint:worktree": "biome check src package.json biome.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.6.1",
    "ts-morph": "28.0.0",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "fast-check": "^4.8.0",
    "tsup": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vitest": "~5.0.1"
  }
}
