[29.445, "o", "    \u001b[38;5;203m\u001b[1m✗\u001b[0m \u001b[38;5;203m\u001b[1mFAILED:\u001b[0m \u001b[38;5;252mship the package\u001b[0m \u001b[38;5;245m→\u001b[0m \u001b[38;5;245mcompensating\u001b[0m\r\n"]
