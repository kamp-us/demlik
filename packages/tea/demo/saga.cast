[0.0, "o", "\u001b[2J\u001b[H"]
[0.3, "o", "\r\n"]
[0.3, "o", "  \u001b[38;5;176m\u001b[1m@demlik/tea/workflow\u001b[0m\u001b[38;5;252m  —  Saga rollback you can replay\u001b[0m\r\n"]
[0.3, "o", "  \u001b[38;5;245m────────────────────────────────────────────────\u001b[0m\r\n"]
[1.0, "o", "\u001b[38;5;245m  A Saga is a distributed transaction: each step commits, and declares the\u001b[0m\r\n"]
[4.182, "o", "\u001b[38;5;245m  compensation that undoes it. No two-phase lock — you roll forward, or you\u001b[0m\r\n"]
[7.407, "o", "\u001b[38;5;245m  roll back by running every committed step's undo, in strict reverse order.\u001b[0m\r\n"]
[11.275, "o", "\u001b[38;5;245m  saga:  order → charge → reserve → ship.   Two scripted paths, one reducer.\u001b[0m\r\n"]
[16.343, "o", "\u001b[38;5;36m❯ \u001b[0m"]
