[18.095, "o", "\r\n"]
[18.595, "o", "  \u001b[38;5;36m\u001b[1mHappy path — every step succeeds\u001b[0m\r\n"]
[19.095, "o", "\u001b[38;5;36m  ✓ all four activities commit in order — the saga settles completed.\u001b[0m\r\n"]
[20.495, "o", "  \u001b[38;5;245mcommitted (forward):\u001b[0m  \u001b[38;5;36m\u001b[1m[order → charge → reserve → ship]\u001b[0m\r\n"]
[20.995, "o", "  \u001b[38;5;245mcompensated (reverse):\u001b[0m  \u001b[38;5;245m[—]\u001b[0m\r\n"]
[21.495, "o", "  \u001b[38;5;245mfinal status:\u001b[0m  \u001b[38;5;36m\u001b[1mcompleted\u001b[0m\r\n"]
