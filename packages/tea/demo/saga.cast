[23.445, "o", "    \u001b[38;5;36m✓\u001b[0m \u001b[38;5;36mdid:\u001b[0m \u001b[38;5;252mreserve inventory\u001b[0m \u001b[38;5;245m→\u001b[0m \u001b[38;5;245mrunning\u001b[0m\r\n"]
[23.745, "o", "    \u001b[38;5;36m✓\u001b[0m \u001b[38;5;36mdid:\u001b[0m \u001b[38;5;252mship the package\u001b[0m \u001b[38;5;245m→\u001b[0m \u001b[38;5;245mcompleted\u001b[0m\r\n"]
[24.045, "o", "\r\n"]
[24.295, "o", "\r\n"]
[24.795, "o", "  \u001b[38;5;203m\u001b[1mForced failure — ship fails, the saga rolls back\u001b[0m\r\n"]
[25.295, "o", "\u001b[38;5;203m  ✗ ship fails after three steps committed — the engine PIVOTS to rollback.\u001b[0m\r\n"]
