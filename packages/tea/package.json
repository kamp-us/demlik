  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "lint": "biome check src package.json",
    "lint:worktree": "biome check src package.json",
    "test": "vitest run",
    "demo:saga": "vitest run src/internal/flow/workflow/demo.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:consumers": "tsc -p tsconfig.consumers.json",
    "docs:reference": "TEA_DOCS_WRITE=1 vitest run src/docs/reference/generate-reference.test.ts",
    "docs:reference:check": "pnpm run docs:reference && git diff --exit-code -- docs/reference",
    "prepublishOnly": "NODE_OPTIONS=--max-old-space-size=8192 tsup && node scripts/verify-exports.mjs",
    "verify-exports": "node scripts/verify-exports.mjs",
    "verify-optional-peer-install": "node scripts/verify-optional-peer-install.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
