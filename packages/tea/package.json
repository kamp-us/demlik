{
  "name": "@demlik/tea",
  "version": "0.18.0",
  "description": "TEA-faithful state machine substrate — one package, every host adapter. Core + subs + testing, plus React, Durable Object, Chrome extension, Node, in-memory, devtools, and property-testing modules as subpaths.",
  "keywords": [
    "tea",
    "elm-architecture",
    "state-machine",
    "reducer",
    "cloudflare",
    "durable-objects",
    "react",
    "effects-as-data"
  ],
  "homepage": "https://demlik.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/demlik.git",
    "directory": "packages/tea"
  },
  "license": "MIT",
  "author": "Can Sirin",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
