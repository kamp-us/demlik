{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // CI typechecks and tests before it builds, so the workspace packages resolve to their
    // source here, not to a `dist/` that does not exist yet. The published package resolves them
    // through their export maps like any other install.
    "paths": {
      "@demlik/tea/jev": ["../tea/src/jev/index.ts"],
      "@demlik/tea/retry-backoff": ["../tea/src/retry-backoff/index.ts"],
      "@demlik/code-graph/project": ["../code-graph/src/project.ts"],
      "@demlik/code-graph/scc": ["../code-graph/src/scc.ts"],
      "@demlik/code-graph/boundaries": [
        "../code-graph/src/boundaries/ledger.ts"
      ]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
